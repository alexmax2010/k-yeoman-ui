{
  "name": "k-yeoman-ui",
  "displayName": "k-yeoman-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Provides rich user experience for Yeoman generators.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "yeoman",
    "yo",
    "wizard",
    "generator",
    "k-yeoman-ui"
  ],
  "bugs": {
    "url": "https://github.com/kruger/yeoman-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kruger/yeoman-ui.git"
  },
  "license": "Apache 2.0",
  "author": {
    "name": "Kruger-Corp"
  },
  "publisher": "Kruger-Corp",
  "main": "./dist/extension",
  "scripts": {
    "bundle": "webpack --mode production",
    "ciKruger": "npm-run-all clean compile  bundle frontend:copy package",
    "ci": "npm-run-all clean compile coverage bundle frontend:copy package coverage:copy",
    "clean": "shx rm -rf ./dist ./coverage *.vsix",
    "clean:frontend": "cd ./dist && shx rm -rf ./media",
    "compile": "tsc",
    "compile:watch": "tsc -watch",
    "coverage": "nyc mocha",
    "coverage:copy": "shx mkdir -p ../../coverage && shx cp -u ./coverage/lcov.info ../../coverage/lcov_backend.info",
    "frontend:copy": "npm-run-all clean:frontend && shx cp -r ../frontend/dist/. ./dist/media/",
    "package": "vsce package --yarn --allow-star-activation",
    "test": "mocha",
    "webpack": "webpack --mode development",
    "webpack-dev:watch": "webpack --mode development --watch",
    "ws:egRun": "node ./dist/src/webSocketServer/exploregens.js",
    "ws:run": "node ./dist/src/webSocketServer/youi.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "yeomanUI._notifyGeneratorsChange",
        "title": "notify about generator change"
      },
      {
        "command": "loadYeomanUI",
        "title": "Open Template Wizard Kruger"
      },
      {
        "command": "yeomanUI.toggleOutput",
        "title": "Show Output",
        "icon": {
          "light": "./resources/images/icons/console_light.svg",
          "dark": "./resources/images/icons/console_dark.svg"
        }
      },
      {
        "command": "exploreGenerators",
        "title": "Explore and Install Generators Kruger"
      },
      {
        "command": "runGenerator",
        "title": "Run Generator"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "k-yeoman-ui",
      "properties": {
        "k-yeoman-ui.RegistryUrl": {
          "type": "string",
          "default": "https://cf1nxs.cfavorita.net/",
          "description": "Registry url.",
          "scope": "resource",
          "order": 1
        },
        "k-yeoman-ui.RegitryPath": {
          "type": "string",
          "default": "repository/npm-internal/-/v1/search",
          "description": "Registry path.",
          "scope": "resource",
          "order": 2
        },
        "k-yeoman-ui.loggingLevel": {
          "type": "string",
          "enum": [
            "off",
            "fatal",
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "off",
          "description": "The verbosity of logging according to the following order: trace > debug > info > warn > error > fatal > off.",
          "scope": "resource"
        },
        "k-yeoman-ui.HideGenerator": {
          "type": "string",
          "default": "",
          "description": "Hide generators from the generator list. The generator name should be in the following format: namespace:generator-name. Generators must be separated by commas.",
          "scope": "resource"
        },
        "k-yeoman-ui.TargetFolder": {
          "type": "string",
          "default": "",
          "description": "Set the default target folder path for the project.",
          "scope": "resource"
        },
        "k-yeoman-ui.Workspace": {
          "type": "string",
          "enum": [
            "Open the project in a stand-alone folder",
            "Open the project in a multi-root workspace",
            "Create the project and close it for future use"
          ],
          "default": "Open the project in a multi-root workspace",
          "description": "Define the preferred behavior upon project creation.",
          "scope": "resource"
        },
        "k-yeoman-ui.sourceLocationTracking": {
          "type": "boolean",
          "default": false,
          "description": "If chosen, the location of the source code is added to log entries. Warning – this action may slow your extension. We recommend you use it only for debugging.",
          "scope": "resource"
        },
        "k-yeoman-ui.installationLocation": {
          "type": "string",
          "markdownDescription": "Set the default folder in which generators will be installed. The path to this folder must be valid. If there is no path defined, the global location will be used."
        },
        "k-yeoman-ui.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update installed generators."
        },
        "k-yeoman-ui.searchQuery": {
          "type": "array",
          "default": [
            "Kruger"
          ],
          "description": "Saved search query."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "yeomanUI.toggleOutput",
          "when": "false"
        },
        {
          "command": "yeomanUI._notifyGeneratorsChange",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "yeomanUI.toggleOutput",
          "group": "navigation",
          "when": "yeomanUI.Focused"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "package-explorer",
          "title": "k-yeoman-ui",
          "icon": "$(file-code)"
        }
      ]
    },
    "views": {
      "package-explorer": [
        {
          "id": "k-yeoman-ui-home",
          "name": "Home"
        },
        {
          "id": "package-outline",
          "name": "Outline"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "k-yeoman-ui-home",
        "contents": "\n[Template wizard](command:loadYeomanUI)\n[Install generators](command:exploreGenerators)\n",
        "when": "true"
      }
    ]
  },
  "activationEvents": [
    "*"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@sap-devx/webview-rpc": "0.4.1",
    "@sap-devx/yeoman-ui-types": "^1.15.0",
    "@sap/bas-sdk": "3.7.11",
    "@sap/swa-for-sapbas-vsx": "2.0.4",
    "@vscode-logging/logger": "2.0.0",
    "chalk": "4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "datauri": "4.1.0",
    "humanize-string": "2.1.0",
    "npm-registry-fetch": "16.1.0",
    "object-hash": "3.0.0",
    "strip-ansi": "6.0.0",
    "sudo-prompt": "9.2.1",
    "titleize": "2.1.0",
    "yeoman-environment": "3.3.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.31",
    "@types/inquirer": "^7.3.3",
    "@types/lodash": "^4.14.170",
    "@types/node": "^14.14.44",
    "@types/npm-registry-fetch": "^8.0.0",
    "@types/object-hash": "^2.1.0",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.50.0",
    "@types/webpack-env": "^1.16.2",
    "@types/ws": "^7.4.5",
    "@types/yeoman-environment": "^2.10.3",
    "copy-webpack-plugin": "^12.0.2",
    "lcov-result-merger": "5.0.0",
    "sinon": "^17.0.1",
    "string-replace-loader": "3.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^9.1.1",
    "vsce": "2.15.0",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "ws": "8.2.3"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "icon": "Wizard_logo.png"
}
